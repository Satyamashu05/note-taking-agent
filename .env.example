# Copy to .env and fill in the blanks: cp .env.example .env

# LLM. Get a free key at https://aistudio.google.com -> Get API key
GEMINI_API_KEY=
LLM_MODEL=gemini-3.5-flash
# Global limit across all workers. Keep below the limit AI Studio shows for your model.
LLM_RPM=5
LLM_MAX_CHARS=60000

# Notion OAuth (public connection in the Notion developer portal)
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=

# Broker and state store (hostnames match the docker-compose services)
RABBITMQ_URL=amqp://app:app@rabbitmq:5672/
REDIS_URL=redis://redis:6379/0

# Retries
MAX_ATTEMPTS=5
BACKOFF_SECONDS=10,30,90,90

# Shared volume for stage outputs
DATA_DIR=/data

# Testing switches (FAULT_STAGE empty = no fault)
FAKE_STAGE_SECONDS=5
FAULT_STAGE=
FAULT_KIND=429
FAULT_TIMES=2
FAULT_FRAME_FAILURES=
FRAME_CHECK=on


