# Gemini (get a free key at https://aistudio.google.com)
GEMINI_API_KEY=
LLM_MODEL=gemini-3.5-flash
LLM_RPM=5
LLM_CHECK_MODEL=gemini-3.5-flash-lite
LLM_CHECK_RPM=15
LLM_MAX_CHARS=60000

# Backup LLMs, tried in this order when the previous one fails (429, outage, bad output).
# A provider without an API key is skipped. All have free tiers.
LLM_PROVIDERS=gemini,groq,openrouter
# Groq (free key: https://console.groq.com) - also used for speech-to-text below
GROQ_API_KEY=
GROQ_TEXT_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=qwen/qwen3.8-27b
GROQ_RPM=30
GROQ_VISION_RPM=10
GROQ_MAX_IMAGES=3
# OpenRouter (free key: https://openrouter.ai/keys) - last resort, 50 free requests/day
OPENROUTER_API_KEY=
OPENROUTER_TEXT_MODEL=openrouter/free
OPENROUTER_VISION_MODEL=openrouter/free
OPENROUTER_RPM=10
# Wait out a 429 this short (seconds) and retry the same provider, instead of moving down the chain
LLM_MAX_WAIT=20
# Testing: comma-separated providers to treat as down (e.g. gemini) to demo the fallback
FAULT_LLM_DOWN=gemini 

# Speech-to-text fallback for videos without captions (uses GROQ_API_KEY above)
ASR_MODEL=whisper-large-v3-turbo

# Testing: 1 = ignore captions and always transcribe the audio
FAULT_NO_CAPTIONS=1


# Notion OAuth (public connection in the Notion developer portal)
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=

# Broker and state store (hostnames match the docker-compose services)
RABBITMQ_URL=amqp://app:app@rabbitmq:5672/
REDIS_URL=redis://redis:6379/0

# Retries
MAX_ATTEMPTS=5
BACKOFF_SECONDS=10,30,90,90

# Shared volume for stage outputs
DATA_DIR=/data

# Frame check: on = Gemini checks each frame and rewrites captions (1 extra call per job)
FRAME_CHECK=on

# Testing switches: leave empty in normal use
FAULT_STAGE=
FAULT_KIND=429
FAULT_TIMES=2
FAULT_FRAME_FAILURES=
FAULT_CRASH_AFTER_PAGE=

# Autoscaler: worker count follows the queue backlog
SCALE_MIN=2
SCALE_MAX=5
SCALE_DOWN_AFTER=60

# Frame-hunting agent: Gemini re-captures rejected frames at better timestamps (needs FRAME_CHECK=on)
FRAME_AGENT=on
FRAME_AGENT_LOOKS=3
FRAME_AGENT_MAX_MISSES=2

# Testing: capture every frame this many seconds too early, so the agent has to hunt
FAULT_FRAME_SHIFT=
