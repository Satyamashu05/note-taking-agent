
GEMINI_API_KEY=
LLM_MODEL=gemini-3.5-flash
LLM_RPM=5
LLM_MAX_CHARS=60000

NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=

RABBITMQ_URL=amqp://app:app@rabbitmq:5672/
REDIS_URL=redis://redis:6379/0

MAX_ATTEMPTS=5
BACKOFF_SECONDS=10,30,90,90

DATA_DIR=/data

FAKE_STAGE_SECONDS=5
FAULT_STAGE=
FAULT_KIND=429
FAULT_TIMES=2
FAULT_FRAME_FAILURES=
FRAME_CHECK=on

FAULT_CRASH_AFTER_PAGE=1

