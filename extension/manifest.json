{
  "manifest_version": 3,
  "name": "Video Note Taker",
  "version": "1.0.0",
  "description": "Turn a YouTube video into study notes with real frames, published to Notion.",
  "key": "",
  "permissions": ["identity", "storage", "alarms"],
  "host_permissions": ["http://localhost:8000/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Video Note Taker", "default_popup": "popup.html" },
  "content_scripts": [{
    "matches": ["https://www.youtube.com/*"],
    "js": ["content.js"],
    "css": ["content.css"]
  }]
}

